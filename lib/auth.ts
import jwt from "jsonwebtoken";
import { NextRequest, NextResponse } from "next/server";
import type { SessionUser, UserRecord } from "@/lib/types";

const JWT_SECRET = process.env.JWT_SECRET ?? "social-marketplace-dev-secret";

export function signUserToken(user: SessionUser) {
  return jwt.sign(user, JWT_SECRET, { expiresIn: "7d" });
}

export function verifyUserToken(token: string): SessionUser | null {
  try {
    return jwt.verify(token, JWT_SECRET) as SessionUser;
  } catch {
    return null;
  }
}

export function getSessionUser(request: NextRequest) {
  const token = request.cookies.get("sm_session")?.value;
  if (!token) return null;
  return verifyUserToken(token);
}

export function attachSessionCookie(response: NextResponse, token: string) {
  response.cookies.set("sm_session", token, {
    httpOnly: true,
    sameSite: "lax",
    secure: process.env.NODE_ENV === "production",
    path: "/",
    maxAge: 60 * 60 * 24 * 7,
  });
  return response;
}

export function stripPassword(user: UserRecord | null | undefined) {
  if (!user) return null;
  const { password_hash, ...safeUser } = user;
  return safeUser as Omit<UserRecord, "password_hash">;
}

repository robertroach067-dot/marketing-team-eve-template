export function getUserByEmail(email: string): UserRecord | undefined {
  return db.prepare("SELECT * FROM users WHERE email = ?").get(email) as UserRecord | undefined;
}

export function getUserById(id: string): UserRecord | undefined {
  return db.prepare("SELECT * FROM users WHERE id = ?").get(id) as UserRecord | undefined;
}

export function createUser({ name, email, passwordHash, role }: { name: string; email: string; passwordHash: string; role: UserRecord["role"] }) {
  const id = crypto.randomUUID();
  db.prepare("INSERT INTO users (id, name, email, password_hash, role) VALUES (?, ?, ?, ?, ?)").run(id, name, email, passwordHash, role);
  return getUserById(id)!;
}

export function listProducts() {
  const rows = db.prepare(
    `
      SELECT p.*, u.name AS seller_name, s.name AS store_name
      FROM products p
      LEFT JOIN users u ON u.id = p.seller_id
      LEFT JOIN storefronts s ON s.owner_id = p.seller_id
      ORDER BY p.created_at DESC
    `,
  ).all() as Array<ProductRecord & { seller_name: string; store_name?: string }>;

  return rows.map((row) => ({
    ...row,
    digital: Boolean(row.digital),
  }));
}

export function getProductById(productId: string) {
  const product = db.prepare(`SELECT p.*, u.name AS seller_name FROM products p LEFT JOIN users u ON u.id = p.seller_id WHERE p.id = ?`).get(productId) as (ProductRecord & { seller_name: string }) | undefined;
  return product ? { ...product, digital: Boolean(product.digital) } : undefined;
}

export function listStorefronts() {
  const rows = db.prepare(
    `
      SELECT s.*, u.name AS owner_name
      FROM storefronts s
      JOIN users u ON u.id = s.owner_id
      ORDER BY s.created_at DESC
    `,
  ).all() as Array<StorefrontRecord & { owner_name: string }>;
  return rows;
}

export function createStorefront({ ownerId, name, tagline, description }: { ownerId: string; name: string; tagline: string; description: string }) {
  const id = crypto.randomUUID();
  db.prepare("INSERT INTO storefronts (id, owner_id, name, tagline, description) VALUES (?, ?, ?, ?, ?)").run(id, ownerId, name, tagline, description);
  return db.prepare("SELECT * FROM storefronts WHERE id = ?").get(id) as StorefrontRecord;
}

export function createProduct({ sellerId, name, description, category, price, stock, digital, imageEmoji }: {
  sellerId: string;
  name: string;
  description: string;
  category: string;
  price: number;
  stock: number;
  digital: boolean;
  imageEmoji: string;
}) {
  const id = crypto.randomUUID();
  db.prepare(
    "INSERT INTO products (id, seller_id, name, description, category, price, stock, digital, image_emoji) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)",
  ).run(id, sellerId, name, description, category, Number(price), Number(stock), digital ? 1 : 0, imageEmoji);
  return getProductById(id)!;
}

export function listFavorites(userId: string) {
  return db.prepare("SELECT product_id FROM favorites WHERE user_id = ?").all(userId) as Array<{ product_id: string }>;
}

export function toggleFavorite({ userId, productId }: { userId: string; productId: string }) {
  const existing = db.prepare("SELECT id FROM favorites WHERE user_id = ? AND product_id = ?").get(userId, productId) as { id: string } | undefined;

  if (existing) {
    db.prepare("DELETE FROM favorites WHERE id = ?").run(existing.id);
    return { action: "removed", favoriteIds: listFavorites(userId).map((item) => item.product_id) };
  }

  const id = crypto.randomUUID();
  db.prepare("INSERT INTO favorites (id, user_id, product_id) VALUES (?, ?, ?)").run(id, userId, productId);
  return { action: "added", favoriteIds: listFavorites(userId).map((item) => item.product_id) };
}

export function createReview({ productId, customerId, rating, comment }: { productId: string; customerId: string; rating: number; comment: string }) {
  const id = crypto.randomUUID();
  db.prepare("INSERT INTO reviews (id, product_id, customer_id, rating, comment) VALUES (?, ?, ?, ?, ?)").run(id, productId, customerId, rating, comment);
  return db.prepare("SELECT * FROM reviews WHERE id = ?").get(id) as ReviewRecord;
}

