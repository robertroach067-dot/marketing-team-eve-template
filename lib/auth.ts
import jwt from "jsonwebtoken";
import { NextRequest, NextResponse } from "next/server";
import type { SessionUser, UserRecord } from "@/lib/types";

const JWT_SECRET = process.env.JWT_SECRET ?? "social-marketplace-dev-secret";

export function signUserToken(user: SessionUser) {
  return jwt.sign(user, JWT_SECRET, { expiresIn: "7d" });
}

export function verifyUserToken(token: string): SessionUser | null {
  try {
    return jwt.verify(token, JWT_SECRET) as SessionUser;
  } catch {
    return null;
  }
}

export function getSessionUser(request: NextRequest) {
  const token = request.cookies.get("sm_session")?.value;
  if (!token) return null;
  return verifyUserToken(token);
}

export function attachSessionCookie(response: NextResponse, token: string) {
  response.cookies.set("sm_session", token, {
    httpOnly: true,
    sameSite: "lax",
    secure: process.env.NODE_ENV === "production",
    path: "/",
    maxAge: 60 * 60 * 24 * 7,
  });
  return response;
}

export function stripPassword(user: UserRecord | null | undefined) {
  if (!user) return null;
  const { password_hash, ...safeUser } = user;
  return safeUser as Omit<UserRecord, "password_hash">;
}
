export function createOrder({ customerId, productId, quantity, shippingAddress }: { customerId: string; productId: string; quantity: number; shippingAddress: string }) {
  const product = getProductById(productId);
  if (!product) throw new Error("Product not found.");

  const sellerId = product.seller_id;
  const total = Number(product.price) * quantity;
  const orderId = crypto.randomUUID();

  db.prepare(
    "INSERT INTO orders (id, customer_id, seller_id, product_id, product_name, quantity, total_amount, status, payment_status, shipping_address) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
  ).run(orderId, customerId, sellerId, productId, product.name, quantity, total, "pending_fulfillment", "pending_provider_confirmation", shippingAddress);

  return db.prepare("SELECT * FROM orders WHERE id = ?").get(orderId) as OrderRecord;
}

export function updateOrderStatus(orderId: string, status: string) {
  db.prepare("UPDATE orders SET status = ? WHERE id = ?").run(status, orderId);
  return db.prepare("SELECT * FROM orders WHERE id = ?").get(orderId) as OrderRecord;
}

export function getMarketplaceOverview() {
  const totalUsers = db.prepare("SELECT COUNT(*) as count FROM users").get() as { count: number };
  const totalProducts = db.prepare("SELECT COUNT(*) as count FROM products").get() as { count: number };
  const totalOrders = db.prepare("SELECT COUNT(*) as count FROM orders").get() as { count: number };
  const totalRevenue = db.prepare("SELECT COALESCE(SUM(total_amount), 0) as total FROM orders").get() as { total: number };

  return {
    total_users: totalUsers.count,
    total_products: totalProducts.count,
    total_orders: totalOrders.count,
    total_revenue: Number(totalRevenue.total).toFixed(2),
  };
}

export function getUserFavoriteIds(userId: string) {
  return listFavorites(userId).map((item) => item.product_id);
}

export function clearPasswordHash(user: UserRecord | undefined) {
  if (!user) return null;
  const { password_hash, ...rest } = user;
  return rest;
}
