import { NextRequest, NextResponse } from "next/server";
import bcrypt from "bcryptjs";
import { z } from "zod";
import { attachSessionCookie, getSessionUser, signUserToken } from "@/lib/auth";
import { createUser, getUserByEmail, getUserFavoriteIds, listProducts, listStorefronts } from "@/lib/db";

const registerSchema = z.object({
  name: z.string().min(2).max(80),
  email: z.string().email(),
  password: z.string().min(8).max(120),
});

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();
    const parsed = registerSchema.safeParse(body);

    if (!parsed.success) {
      return NextResponse.json({ error: "Please provide a valid name, email, and password." }, { status: 400 });
    }

    const { name, email, password } = parsed.data;
    if (getUserByEmail(email)) {
      return NextResponse.json({ error: "An account already exists for that email address." }, { status: 400 });
    }

    const passwordHash = await bcrypt.hash(password, 10);
    const createdUser = createUser({
      name,
      email,
      passwordHash,
      role: "customer",
    });

    const user = {
      id: createdUser.id,
      name: createdUser.name,
      email: createdUser.email,
      role: createdUser.role,
    };

    const token = signUserToken(user);
    const response = NextResponse.json({ user, favoriteIds: [] }, { status: 201 });
    attachSessionCookie(response, token);
    return response;
  } catch (error) {
    console.error("Register error", error);
    return NextResponse.json({ error: "Unable to create your account." }, { status: 500 });
  }
}

export async function GET() {
  return NextResponse.json({ ok: true, message: "Registration endpoint ready." });
}
