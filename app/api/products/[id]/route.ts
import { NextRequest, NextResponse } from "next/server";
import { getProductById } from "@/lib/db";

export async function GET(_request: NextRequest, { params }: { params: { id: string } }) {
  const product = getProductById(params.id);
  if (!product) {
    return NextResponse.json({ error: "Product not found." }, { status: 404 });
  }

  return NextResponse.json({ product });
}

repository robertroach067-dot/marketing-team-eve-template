import { NextRequest, NextResponse } from "next/server";
import { z } from "zod";
import { getSessionUser } from "@/lib/auth";
import { createProduct, getProductById, listProducts } from "@/lib/db";

const createProductSchema = z.object({
  name: z.string().min(2).max(120),
  category: z.string().min(2).max(40),
  description: z.string().min(10).max(500),
  price: z.number().positive(),
  stock: z.number().int().min(0),
  digital: z.boolean(),
  image_emoji: z.string().min(1).max(10),
});

export async function GET() {
  return NextResponse.json({ products: listProducts() });
}

export async function POST(request: NextRequest) {
  const user = getSessionUser(request);
  if (!user || (user.role !== "vendor" && user.role !== "admin")) {
    return NextResponse.json({ error: "Vendor access required to publish products." }, { status: 403 });
  }

  try {
    const body = await request.json();
    const parsed = createProductSchema.safeParse(body);
    if (!parsed.success) {
      return NextResponse.json({ error: "Product details are invalid." }, { status: 400 });
    }

    const product = createProduct({
      sellerId: user.id,
      name: parsed.data.name,
      description: parsed.data.description,
      category: parsed.data.category,
      price: parsed.data.price,
      stock: parsed.data.stock,
      digital: parsed.data.digital,
      imageEmoji: parsed.data.image_emoji,
    });

    return NextResponse.json({ product }, { status: 201 });
  } catch (error) {
    console.error("Product create error", error);
    return NextResponse.json({ error: "Unable to create product." }, { status: 500 });
  }
}
