:root {
  --bg: #0d0d14;
  --bg-soft: #171725;
  --panel: #1d1d2f;
  --panel-alt: #f8f7ff;
  --card: #fff;
  --text: #111827;
  --text-light: #4b5563;
  --muted: #6b7280;
  --red: #ef4444;
  --purple: #7c3aed;
  --yellow: #facc15;
  --green: #22c55e;
  --border: rgba(17, 24, 39, 0.12);
  --shadow: 0 18px 45px rgba(59, 39, 84, 0.18);
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, #fff7ed 0%, #f5f3ff 100%);
  color: var(--text);
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.container {
  max-width: 1280px;
  margin: 0 auto;
  padding: 0 20px;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(13, 13, 20, 0.92);
  backdrop-filter: blur(12px);
  color: white;
  border-bottom: 1px solid rgba(255, 255, 255, 0.08);
}

.topbar-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: 1280px;
  margin: 0 auto;
  padding: 16px 20px;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 12px;
  font-weight: 800;
  letter-spacing: 0.02em;
}

.brand-mark {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--red), var(--purple), var(--yellow));
  font-size: 18px;
  color: #111827;
}

.nav {
  display: flex;
  align-items: center;
  gap: 20px;
  color: rgba(255, 255, 255, 0.86);
}

.nav a:hover {
  color: white;
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}

.button,
.primary,
.secondary,
.ghost {
  border: none;
  border-radius: 999px;
  padding: 12px 18px;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.primary {
  background: linear-gradient(135deg, var(--red), var(--purple));
  color: white;
  box-shadow: 0 12px 22px rgba(130, 61, 207, 0.18);
}

.secondary {
  background: linear-gradient(135deg, var(--yellow), #f59e0b);
  color: #111827;
}

.ghost {
  background: rgba(255, 255, 255, 0.08);
  color: white;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.button:hover,
.primary:hover,
.secondary:hover,
.ghost:hover {
  transform: translateY(-1px);
}

.hero {
  padding: 56px 0 30px;
  background: radial-gradient(circle at top left, rgba(124, 58, 237, 0.2), transparent 28%),
    radial-gradient(circle at top right, rgba(239, 68, 68, 0.15), transparent 22%),
    linear-gradient(180deg, #0d0d14 0%, #1b1233 100%);
  color: white;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 32px;
  align-items: center;
}

.hero-copy h1 {
  font-size: clamp(2.5rem, 5vw, 4.5rem);
  line-height: 1.04;
  margin: 0 0 18px;
}

.hero-copy p {
  font-size: 1.08rem;
  line-height: 1.7;
  color: rgba(255, 255, 255, 0.8);
  max-width: 620px;
}

.hero-actions {
  margin-top: 28px;
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(3, minmax(120px, 1fr));
  gap: 16px;
  margin-top: 28px;
}

.metric {
  padding: 18px 16px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.1);
  border-radius: 18px;
}

.metric strong {
  display: block;
  font-size: 1.5rem;
  margin-bottom: 4px;
}

.hero-panel {
  background: rgba(255,255,255,0.04);
  border: 1px solid rgba(255,255,255,0.12);
  padding: 24px;
  border-radius: 28px;
  box-shadow: var(--shadow);
}

.feature-card {
  padding: 16px;
  border-radius: 18px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.1);
  margin-bottom: 16px;
}

.feature-card:last-child {
  margin-bottom: 0;
}

.section {
  padding: 42px 0;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16px;
  margin-bottom: 22px;
}

.section-header h2 {
  margin: 0;
  font-size: clamp(1.8rem, 3vw, 2.6rem);
}

.filters {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pill {
  background: white;
  border: 1px solid var(--border);
  color: var(--text);
  border-radius: 999px;
  padding: 8px 14px;
  font-weight: 700;
}

.pill.active {
  background: linear-gradient(135deg, var(--red), var(--purple));
  color: white;
  border-color: transparent;
}

.product-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
}

.card {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  overflow: hidden;
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.06);
}

.product-image {
  position: relative;
  height: 200px;
  background: linear-gradient(135deg, rgba(248, 113, 113, 0.2), rgba(167, 139, 250, 0.3), rgba(250, 204, 21, 0.28));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3rem;
}

.card-body {
  padding: 18px;
}

.card-body h3 {
  margin: 0 0 8px;
  font-size: 1.18rem;
}

.meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  color: var(--text-light);
  font-size: 0.9rem;
  margin-bottom: 12px;
}

.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-top: 16px;
}

.price {
  font-size: 1.35rem;
  font-weight: 800;
  color: var(--purple);
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  border-radius: 999px;
  padding: 6px 10px;
  font-weight: 700;
  font-size: 0.72rem;
}

.badge.green {
  background: rgba(34, 197, 94, 0.12);
  color: #166534;
}

.badge.purple {
  background: rgba(124, 58, 237, 0.12);
  color: #5b21b6;
}

.app-shell {
  display: grid;
  grid-template-columns: 360px 1fr;
  gap: 24px;
  align-items: start;
}

.panel {
  background: white;
  border: 1px solid var(--border);
  border-radius: 22px;
  padding: 20px;
  box-shadow: 0 10px 28px rgba(15, 23, 42, 0.04);
}

.form-grid {
  display: grid;
  gap: 16px;
}

.field {
  display: grid;
  gap: 8px;
}

.field label {
  font-weight: 700;
  color: var(--text);
}

.field input,
.field select,
.field textarea {
  width: 100%;
  border-radius: 14px;
  border: 1px solid rgba(17,24,39,0.12);
  background: #f9fafb;
  padding: 12px 14px;
  color: var(--text);
}

.field textarea {
  min-height: 110px;
  resize: vertical;
}

.list {
  display: grid;
  gap: 12px;
}

.list-item {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  padding: 12px 14px;
  border: 1px solid var(--border);
  border-radius: 14px;
}

.inline-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

.notice {
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(34, 197, 94, 0.08);
  border: 1px solid rgba(34, 197, 94, 0.2);
  color: #166534;
  font-weight: 600;
}

.warning {
  padding: 12px 14px;
  border-radius: 14px;
  background: rgba(250, 204, 21, 0.12);
  border: 1px solid rgba(245, 158, 11, 0.24);
  color: #92400e;
  font-weight: 600;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
}

.stat-box {
  padding: 18px;
  border-radius: 18px;
  background: linear-gradient(135deg, rgba(124, 58, 237, 0.08), rgba(239, 68, 68, 0.06));
  border: 1px solid rgba(124, 58, 237, 0.12);
}

.stat-box strong {
  display: block;
  font-size: 2rem;
  margin-bottom: 6px;
}

@media (max-width: 1024px) {
  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hero-grid,
  .app-shell {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .nav {
    display: none;
  }

  .product-grid,
  .metrics,
  .stat-grid {
    grid-template-columns: 1fr;
  }

  .topbar-inner {
    flex-wrap: wrap;
  }
}
